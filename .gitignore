# dependencies / tool caches
node_modules/
.pw/
.vhs/
.playwright-cli/
.hyperframes/
hyperframes.lock.json

# generated media (keep source: index.html, capture.js, brief.yaml, tokens.json, logo.svg)
*.webm
*.mp4
*.mp3
*.wav
**/renders/*
!**/renders/contact-sample.png
!**/renders/thumbnail.jpg
!**/renders/demo.gif

# secrets / state
.env
.env.*
.secrets/
*storage-state*.json

# internal / not-public working material (kept local, never committed to this public repo)
demo-scripts/

# project workspaces — allowlist: only curated PUBLIC examples are committed.
# Local/personal walkthroughs + loose scratch stay out; add a "!" line to publish one.
/projects/*
!/projects/example-walkthrough/
!/projects/example-cli-tour/

# host-specific / local-only capture helpers (not part of the public skill)
.claude/skills/devrel-video/scripts/*.mjs
/record-longer.mjs
/save-auth.mjs

# python
__pycache__/

# os
.DS_Store

# narration build artifact (regenerated by narrate.py)
**/timing.json
